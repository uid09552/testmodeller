# Copy to .env and edit. .env is gitignored — never commit real secrets.
#   cp .env.example .env

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=testmodeller
POSTGRES_USER=testmodeller
# Required. Generate one with: openssl rand -base64 24
POSTGRES_PASSWORD=

# ── Backend ───────────────────────────────────────────────────────────────────
TM_DB_MAX_CONNECTIONS=10
# Only needed when calling the backend port directly from a browser; traffic
# through the gateway is same-origin.
TM_CORS_ORIGIN=http://localhost:8088
RUST_LOG=info,tm_api=debug

# ── AI provider (docs/specification/07-ai-integration.md) ─────────────────────
# Configured here, not in the UI. The backend reads these at startup; change
# them and restart (`make up`) to switch provider.
#
# TM_AI_PROVIDER: claude | ollama | openai-compatible | none
#   (the API's own names anthropic and local are accepted too)
TM_AI_PROVIDER=none

# Model id.
#   Claude:  claude-opus-5-5, claude-sonnet-5-5, claude-haiku-4-5-20251001
#   Ollama:  whatever `ollama list` shows, e.g. llama3.1
TM_AI_MODEL=gpt-oss:120b

# Endpoint of the provider's API.
#   Claude:  leave empty for https://api.anthropic.com
#   Ollama:  the host Ollama runs on, with /v1. From inside Docker, `localhost`
#            is the backend container itself, so use host.docker.internal for
#            an Ollama on this machine: http://host.docker.internal:11434/v1
#            (and http://localhost:11434/v1 with `make dev`).
TM_AI_BASE_URL=https://ollama.com/v1

# API key. Required for Claude; leave empty for a local Ollama. Never logged.
TM_AI_API_KEY=

# Optional output token budget per request.
TM_AI_MAX_TOKENS=5000

# Encrypts a key saved through PUT /settings/ai. Not needed when the key comes
# from TM_AI_API_KEY above. Generate one with: openssl rand -base64 32
TM_SECRET_KEY=

# ── Authentication (docs/specification/08-usermanagement.md) ──────────────────
# JWKS or OIDC discovery URL the backend validates tokens against. Required
# unless the backend runs with --dev-mode.
#   e.g. https://idp.example.com/realms/testmodeller/protocol/openid-connect/certs
TM_JWKS_URL=
# Claim carrying the org id used as the tenant, and the claim carrying the role.
TM_TENANT_CLAIM=tenant
TM_ROLE_CLAIM=roles
# Optional extra checks; leave empty to skip.
TM_JWT_ISSUER=
TM_JWT_AUDIENCE=

# ── Gateway (APISIX, performs the OIDC handshake) ─────────────────────────────
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Discovery document of your identity provider.
#   e.g. https://idp.example.com/realms/testmodeller/.well-known/openid-configuration
OIDC_DISCOVERY=
OIDC_REALM=testmodeller
OIDC_REDIRECT_URI=http://localhost:8088/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:8088/
# Signs the session cookie. Generate one with: openssl rand -hex 32
OIDC_SESSION_SECRET=

# ── Frontend ──────────────────────────────────────────────────────────────────
# Host port for the gateway, which serves the app and proxies the API.
# Avoids 8080 (used by `make dev`) and 4200 (used by `make dev-fe`).
FRONTEND_PORT=8088
