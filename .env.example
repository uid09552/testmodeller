# Copy to .env and edit. .env is gitignored — never commit real secrets.
#   cp .env.example .env

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=testmodeller
POSTGRES_USER=testmodeller
# Required. Generate one with: openssl rand -base64 24
POSTGRES_PASSWORD=

# ── Backend ───────────────────────────────────────────────────────────────────
TM_DB_MAX_CONNECTIONS=10
# Only needed when calling the published backend port directly from a browser;
# traffic through nginx is same-origin.
TM_CORS_ORIGIN=http://localhost:8088
RUST_LOG=info,tm_api=debug

# LLM provider key for AI proposals. Kept in memory by the backend — never
# persisted to the database and never logged. Leave empty to disable AI features.
TM_AI_API_KEY=

# ── Frontend ──────────────────────────────────────────────────────────────────
# Host port for the app; the container always listens on 80.
# Avoids 8080 (used by `make dev`) and 4200 (used by `make dev-fe`).
FRONTEND_PORT=8088
